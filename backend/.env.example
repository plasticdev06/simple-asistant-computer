# Copia este archivo como ".env" y pega tu API key gratuita de https://console.groq.com/keys
GROQ_API_KEY=tu_api_key_aqui

# Voz para edge-tts. Prueba otras con: edge-tts --list-voices
TTS_VOICE=es-MX-DaliaNeural

# Modelo de lenguaje en Groq
GROQ_MODEL=llama-3.3-70b-versatile

# Modelo de transcripción de voz en Groq
GROQ_ASR_MODEL=whisper-large-v3
